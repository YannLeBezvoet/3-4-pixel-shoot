{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Path to the JSON Schema, for editor autocompletion.",
      "type": "string"
    },
    "characters": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Identifier, unique within its file: lowercase letters, digits and hyphens."
          },
          "nameKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
            "description": "Key of a text in the theme translation files (locales/<language>.json)."
          },
          "faction": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Faction this character belongs to (theme.json)."
          },
          "sprite": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+(\\/[a-z0-9_-]+)*$",
            "description": "Character sprite: tags idle, walk, death in the 5 drawn directions and a \"hand\" slice."
          },
          "weapon": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Primary weapon (weapons.json); not a thrown weapon."
          },
          "throwable": {
            "description": "Thrown weapon carried along with the primary one (weapons.json).",
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "speed": {
            "default": 180,
            "description": "Top speed in pixels per second (one tile is 48 pixels).",
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000
          },
          "radius": {
            "default": 10,
            "description": "Radius of the collision circle around the feet, in pixels; also used for bullet hits. At most 23, so a character fits through a one-tile gap.",
            "type": "number",
            "minimum": 4,
            "maximum": 23
          },
          "hitPoints": {
            "default": 100,
            "description": "Hit points at the start of each life.",
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "effects": {
            "default": {},
            "description": "Visual effects of this character.",
            "type": "object",
            "properties": {
              "hit": {
                "description": "Effect shown where a projectile hits this character.",
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "nameKey",
          "faction",
          "sprite",
          "weapon"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "characters"
  ],
  "additionalProperties": false,
  "title": "Theme characters (characters.json)"
}
